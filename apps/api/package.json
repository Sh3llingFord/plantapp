    "@plantapp/shared": "workspace:*",
    "argon2": "^0.41.0",
    "better-sqlite3": "^11.5.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
